# AgentCollar keeps its settings in ~/.agentcollar/.env (folder 700, file 600).
# You do not need to edit anything by hand: `agcl setup` writes that file for you.
# This file only documents the variables it may contain. It has no secrets.

# From @BotFather. Empty = approve mandates in the broker's terminal instead.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id: `agcl setup` takes it from your Start message.
# Only this user can approve.
TELEGRAM_USER_ID=

# BROKER_PORT=8787
# AGENTCOLLAR_HOME=~/.agentcollar     (move all data elsewhere)
