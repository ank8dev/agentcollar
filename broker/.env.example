# Copy this file to .env and fill it in:  cp .env.example .env
# .env is in .gitignore: it is never committed. This example file has no secrets.

# From @BotFather (/newbot). Leave empty to approve mandates in the terminal instead.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id (from @userinfobot). Only this user can approve.
TELEGRAM_USER_ID=

# BROKER_PORT=8787
