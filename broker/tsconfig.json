{
  "compilerOptions": {
    // Modern JavaScript that Node 22 understands natively
    "target": "ES2022",
    // Use Node's own rules for `import` (ES modules)
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Strictest type checking: catches mistakes before the code runs
    "strict": true,
    // tsx runs the code; tsc only checks types and writes no files
    "noEmit": true,
    // Lets us write `import ... from "./mandate.ts"` (allowed because tsc writes no files)
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "test", "tools"]
}
